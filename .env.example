# Copy to .env; never commit the populated file.
# Dataset CLI reads exported environment variables; it does not auto-load .env.
DATASET_ROOT=./data/raw/ACRIMA
ARTIFACTS_ROOT=./artifacts
PROJECT_CONFIG=./configs/project.yaml
# auto, cpu, or gpu; implementation deferred
COMPUTE_DEVICE=cpu
RANDOM_SEED=42
# Backend only. NEVER use a VITE_ prefix for secrets.
GEMINI_API_KEY=
GEMINI_MODEL=
FRONTEND_ORIGIN=http://localhost:5173
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
# Public frontend configuration; no credentials here.
VITE_API_BASE_URL=http://localhost:5000
