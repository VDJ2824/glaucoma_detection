{
  "members": [
    "mobilenet_v2",
    "efficientnet_b0",
    "resnet50"
  ],
  "grid_denominator": 20,
  "include_exact_equal_weights": true,
  "criterion": "minimum_validation_binary_crossentropy",
  "tie_tolerance": 1e-12,
  "tie_break": "closest_to_equal_then_lexicographic",
  "threshold": 0.5,
  "threshold_rule": "score_greater_than_or_equal",
  "threshold_selection": "predefined_not_tuned",
  "bce_epsilon": 1e-07
}
